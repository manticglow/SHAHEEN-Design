{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "fra1"
  ],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/s/:slug",
      "destination": "/api/index?__p=s/:slug"
    },
    {
      "source": "/",
      "destination": "/api/index?__p="
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/index?__p=sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/index?__p=robots.txt"
    },
    {
      "source": "/admin",
      "destination": "/api/index?__p=admin"
    },
    {
      "source": "/webhook",
      "destination": "/api/index?__p=webhook"
    },
    {
      "source": "/leads",
      "destination": "/api/index?__p=leads"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/index?__p=api/:path*"
    },
    {
      "source": "/:page([a-z][a-z0-9-]{1,40})",
      "destination": "/api/index?__p=:page"
    },
    {
      "source": "/:path*",
      "destination": "/api/index?__p=:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(self)"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/lib/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/apps/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, must-revalidate"
        }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{lib/site.html,404.html,privacy.html,terms.html,refund.html,delivery.html,complaints.html,carwash.html,tenant.html,app.html,demos.html,invitations.html}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 6 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "shaheendesign.sa"
        }
      ],
      "destination": "https://www.shaheendesign.sa/:path*",
      "permanent": true
    }
  ]
}
